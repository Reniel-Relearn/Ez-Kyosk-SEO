---
import BrandLogo from '../components/BrandLogo.astro';
import { brandName } from '../lib/brand';
import { sitePath } from '../lib/sitePath';
import '../styles/global.css';
import '../styles/navigation.css';
import '../styles/ending.css';
import { navigation } from '../data/navigation';

const {
  homeHero = false,
  legacy = false,
  title = 'Self-Ordering Kiosk Philippines | Ez Kyosk',
  description = 'Ez Kyosk is self-ordering kiosk software for Philippine hospitality, retail, wellness, and service businesses. Explore the product or request a demo.',
} = Astro.props;

const pathname = Astro.url.pathname;
const canonical = Astro.site ? new URL(pathname, Astro.site).href : undefined;
const siteRoot = Astro.site ? new URL(sitePath('/'), Astro.site).href : undefined;
const sharingImageUrl = Astro.site ? new URL(sitePath('/brand-social.png'), Astro.site).href : undefined;
const documentTitle = title.includes('Ez Kyosk') ? title : `${title} | Ez Kyosk`;
const isCurrent = (url: string) => pathname === sitePath(url);
const schema = canonical ? {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${siteRoot}#website`, name: brandName, url: siteRoot, inLanguage: 'en-PH' },
    { '@type': 'WebPage', '@id': `${canonical}#webpage`, name: documentTitle, description, url: canonical, inLanguage: 'en-PH', isPartOf: { '@id': `${siteRoot}#website` } },
  ],
} : undefined;
---
<!doctype html>
<html lang="en-PH" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        let theme = 'light';
        try {
          const saved = localStorage.getItem('ez-kyosk-theme');
          theme = saved === 'light' || saved === 'dark'
            ? saved
            : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        } catch {}
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.replace('no-js', 'js');
      })();
    </script>
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8fafc" />
    <link rel="icon" href={sitePath('/favicon.png')} type="image/png" sizes="64x64" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:locale" content="en_PH" />
    {canonical && <meta property="og:url" content={canonical} />}
    {sharingImageUrl && <><meta property="og:image" content={sharingImageUrl} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Official Ez Kyosk logo and self-ordering kiosk icon" /></>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    {sharingImageUrl && <><meta name="twitter:image" content={sharingImageUrl} /><meta name="twitter:image:alt" content="Official Ez Kyosk logo and self-ordering kiosk icon" /></>}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />}
    {(!Astro.site || legacy) && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body data-home-hero={homeHero ? 'true' : undefined} data-home-url={sitePath('/')}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-site-header>
      <BrandLogo eager />
      <nav id="main-navigation" class="site-nav" aria-label="Main navigation">
        {navigation.map(({path,label,section}) => <a href={sitePath(path)} data-section={section} aria-current={isCurrent(path) && (!section || section === 'home') ? 'page' : undefined}>{label}</a>)}
        <a class="nav-mobile-cta" href={sitePath('/contact/')}>Request a Demo <span aria-hidden="true">↗</span></a>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
        <svg class="theme-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z" /></svg>
        <svg class="theme-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
      </button>
      <a class="header-cta" href={sitePath('/contact/')}>Request a Demo <span aria-hidden="true">↗</span></a>
      <button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-controls="main-navigation" aria-expanded="false"><span></span><span></span></button>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-grid">
        <div class="footer-brand">
          <BrandLogo />
          <p>Self-ordering, checkout, payments, and connected operations, built around your business.</p>
          <a class="text-link" href="https://reniel-relearn.github.io/EZ-Kyosk/" target="_blank" rel="noopener">Explore the kiosk experience <span aria-hidden="true">↗</span></a>
        </div>
        <div class="footer-links"><span class="footer-label">Products</span><a href={sitePath('/')} data-section="products">Explore products</a><a href={sitePath('/')} data-section="how-it-works">How It Works</a><a href={sitePath('/offers/')}>Plans &amp; Pricing</a></div>
        <div class="footer-links"><span class="footer-label">Industries</span><a href={sitePath('/')} data-section="industry-hospitality">Hospitality &amp; food</a><a href={sitePath('/')} data-section="industry-retail">Retail &amp; shops</a><a href={sitePath('/')} data-section="industry-wellness">Wellness &amp; beauty</a><a href={sitePath('/')} data-section="industry-services">Services &amp; B2B</a></div>
        <div class="footer-links"><span class="footer-label">Company</span><a href={sitePath('/')} data-section="about-us">About Us</a><a href={sitePath('/articles/')}>Articles</a><a href={sitePath('/contact/')}>Request a Demo</a><a href={sitePath('/privacy/')}>Privacy notice</a></div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Ez Kyosk.</span><span>Your Menu. Their Order. One Simple Screen.</span></div>
    </footer>
    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const applyTheme = (theme: 'light' | 'dark', save = true) => {
        document.documentElement.dataset.theme = theme;
        themeToggle?.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} mode`);
        themeToggle?.setAttribute('aria-pressed', String(theme === 'dark'));
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#080d16' : '#f8fafc');
        if (save) {
          try { localStorage.setItem('ez-kyosk-theme', theme); } catch {}
        }
      };
      applyTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light', false);
      themeToggle?.addEventListener('click', () => applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'));

      const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      const nav = document.querySelector<HTMLElement>('#main-navigation');
      const closeMenu = (restoreFocus = false) => {
        button?.setAttribute('aria-expanded', 'false');
        header?.classList.remove('nav-open');
        if (restoreFocus) button?.focus();
      };
      button?.addEventListener('click', event => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        header?.classList.toggle('nav-open', open);
        if (open && event.detail === 0) nav?.querySelector<HTMLAnchorElement>('a')?.focus();
      });
      nav?.addEventListener('click', event => { if ((event.target as HTMLElement).closest('a')) closeMenu(); });
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') closeMenu(true); });
      document.addEventListener('click', event => { if (event.target instanceof Node && !header?.contains(event.target)) closeMenu(); });
      window.matchMedia('(min-width: 1181px)').addEventListener('change', () => closeMenu());

      const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('reveal-ready');
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              (entry.target as HTMLElement).classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        reveals.forEach(element => observer.observe(element));
      } else reveals.forEach(element => element.classList.add('is-visible'));
    </script>
    <script>import '../scripts/section-navigation';</script>
  </body>
</html>
