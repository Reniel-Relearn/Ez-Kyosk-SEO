---
import Layout from '../layouts/Layout.astro';
import ProductVisualPlaceholder from '../components/ProductVisualPlaceholder.astro';
import { productPageMeta, coreCapabilities, configurableAdditions, purchaseOptions } from '../data/productPage';
import { sitePath } from '../lib/sitePath';
import '../styles/product-page.css';

const sectionLinks = [
  ['#product-areas', 'Core capabilities'], ['#configurable-additions', 'Configurable additions'],
  ['#payments', 'Payments'], ['#purchase-options', 'Ways to purchase'], ['#compatibility', 'Compatibility & quotation'],
];
const productLink = (href: string) => href.startsWith('#') ? href : sitePath(href);
---
<Layout title={productPageMeta.title} description={productPageMeta.description}>
  <div class="product-page">
    <section class="product-intro section-shell" aria-labelledby="product-heading">
      <div class="product-intro-copy">
        <span class="eyebrow brand-case">Ez Kyosk product · Connected capabilities</span>
        <h1 id="product-heading">One connected system.<br /><span>Defined around your business.</span></h1>
        <p class="product-intro-lead">Ez Kyosk connects self-ordering, POS checkout, payments and order queue tracking. Choose software, hardware or a combined setup, with additional capabilities scoped to your requirements.</p>
        <p class="product-intro-context">For Philippine businesses planning a customer-facing ordering system, this is where you can explore what the system provides and what your quotation needs to define.</p>
        <div class="hero-actions"><a class="button" href="#product-areas">Explore the capabilities <span aria-hidden="true">↓</span></a><a class="button button-secondary" href={sitePath('/contact/')}>Request a Demo</a></div>
      </div>
      <ProductVisualPlaceholder label="Connected Ez Kyosk system overview" hero />
    </section>

    <nav class="product-section-nav section-shell" aria-label="Product page sections">
      <span>On this page</span>{sectionLinks.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>

    <section class="product-core product-content-section section-shell" id="product-areas" aria-labelledby="product-core-title">
      <div class="product-section-intro"><span class="eyebrow">Core connected capabilities</span><h2 id="product-core-title">From customer choice to a trackable order.</h2><p>The core experience connects browsing, order review, checkout, supported payments and queue tracking. Each capability has a clear role for the customer and the business.</p></div>
      <div class="product-capability-list">{coreCapabilities.map(capability => (
        <article class="product-capability" id={capability.id} aria-labelledby={`${capability.id}-heading`}>
          <div class="product-capability-copy"><span class="product-category-label">{capability.label}</span><h3 id={`${capability.id}-heading`}>{capability.title}</h3><p>{capability.body}</p><ul class="product-fact-list">{capability.points.map(point => <li>{point}</li>)}</ul><p class="product-scope-note">{capability.note}</p>{capability.link && <a class="text-link" href={productLink(capability.link.href)}>{capability.link.label} <span aria-hidden="true">↗</span></a>}</div>
          <ProductVisualPlaceholder label={capability.visual} />
        </article>
      ))}</div>
    </section>

    <section class="product-additions product-content-section section-shell" id="configurable-additions" aria-labelledby="product-additions-title">
      <div class="product-section-intro"><span class="eyebrow">Configured when you need it</span><h2 id="product-additions-title">Add the capabilities your operation needs.</h2><p>Automated inventory, reporting and customer tools are quotation-dependent additions. We define the requested scope with you instead of treating every feature as a standard inclusion.</p></div>
      <div class="product-addition-grid">{configurableAdditions.map(addition => (
        <article class="product-addition-card" id={addition.id} aria-labelledby={`${addition.id}-heading`}>
          <ProductVisualPlaceholder label={addition.visual} />
          <div class="product-addition-copy"><span class="product-category-label">Quotation-dependent</span><h3 id={`${addition.id}-heading`}>{addition.title}</h3><p>{addition.body}</p><h4>What we define with you</h4><ul class="product-fact-list">{addition.points.map(point => <li>{point}</li>)}</ul></div>
        </article>
      ))}</div>
      <p class="product-section-followup">Other requirements can be scoped for your business. <a href={sitePath('/contact/')}>Discuss the additional capabilities you need.</a></p>
    </section>

    <section class="product-payments product-content-section section-shell" id="payments" aria-labelledby="product-payments-title">
      <div class="product-section-intro"><span class="eyebrow">Payments with AltPayNet</span><h2 id="product-payments-title">Payment choices, defined for your deployment.</h2><p>Ez Kyosk supports electronic payment paths through AltPayNet, with an optional cashier route for cash. Available methods and device requirements are confirmed for your setup.</p></div>
      <div class="product-payment-layout">
        <div class="product-payment-copy">
          <div><h3>Supported electronic payments</h3><p>Card, QR, GCash, Maya and other supported e-wallet paths can serve different checkout needs. In-store terminal and supported mobile payment requirements are discussed as part of the deployment.</p><ul class="product-method-list" aria-label="Payment methods to discuss"><li>Card</li><li>QR</li><li>GCash</li><li>Maya</li><li>Supported e-wallets</li></ul></div>
          <div><h3>Optional cash at the cashier</h3><p>Customers who choose cash complete payment with the cashier. After payment, the cashier can provide the order number, a tracking QR, or both. Customers can then follow their number on the queue display or choose phone-based tracking.</p></div>
          <aside class="product-payment-note" aria-label="Payment and tracking QR distinction"><strong>Payment QR and tracking QR have different purposes.</strong><p>A payment QR is part of the payment path. A tracking QR opens order status after successful payment. Customers do not need to scan the tracking QR to follow their number on the queue display.</p></aside>
        </div>
        <ProductVisualPlaceholder label="Payment paths and the post-payment tracking handoff" />
      </div>
    </section>

    <section class="product-purchasing product-content-section section-shell" id="purchase-options" aria-labelledby="product-purchasing-title">
      <div class="product-section-intro"><span class="eyebrow">Ways to purchase</span><h2 id="product-purchasing-title">Software, hardware or a combined setup.</h2><p>Ez Kyosk is available through software-only, hardware-only and combined quotations. The right scope depends on your existing setup and the operation you want to support.</p></div>
      <div class="product-purchase-grid">{purchaseOptions.map(option => (
        <article class="product-purchase-card"><h3>{option.title}</h3><p>{option.body}</p><div><h4>Confirm in the quotation</h4><p>{option.confirm}</p></div></article>
      ))}</div>
      <p class="product-pricing-note"><strong>Pricing depends on the agreed requirements.</strong> Your quotation defines the selected software, hardware, integrations, customization and payment terms. Specific equipment, services and package inclusions are confirmed there.</p>
    </section>

    <section class="product-compatibility product-content-section section-shell" id="compatibility" aria-labelledby="product-compatibility-title">
      <div class="product-section-intro"><span class="eyebrow">Compatibility & quotation</span><h2 id="product-compatibility-title">Define the fit before committing to the setup.</h2><p>Compatibility with an existing POS, printer, payment device or other system is assessed during consultation. We do not assume that every device or integration is supported.</p></div>
      <div class="product-requirements-grid">
        <div class="product-requirements-card"><h3>What to share with us</h3><ul class="product-fact-list"><li>Your menu or catalogue, product options and ordering flow.</li><li>Your preferred payment paths and any cashier requirements.</li><li>Your existing hardware, POS, printers and other systems.</li><li>Your inventory, reporting or customer-tool requirements.</li></ul></div>
        <div class="product-requirements-card"><h3>How the scope is agreed</h3><ol class="product-quotation-steps"><li><strong>Discuss the operation.</strong><span>Explain the customer experience and business requirements you need to support.</span></li><li><strong>Assess the requirements.</strong><span>Review the devices, integrations and configurable features needed for the setup.</span></li><li><strong>Review the quotation.</strong><span>Confirm the included scope and terms before approving implementation.</span></li></ol></div>
      </div>
      <div class="product-related-links"><a class="text-link" href={sitePath('/how-it-works/')}>Understand the customer journey <span aria-hidden="true">↗</span></a><a class="text-link" href={sitePath('/solutions/')}>Explore industry use cases <span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="product-final-cta section-shell" aria-labelledby="product-cta-title">
      <div><span class="eyebrow">Built around your requirements</span><h2 id="product-cta-title">Let’s define your Ez Kyosk setup.</h2><p>Tell us about your products, payment preferences and existing systems. We can discuss the capabilities and configuration to include in your quotation.</p></div>
      <div class="hero-actions"><a class="button" href={sitePath('/contact/')}>Request a Demo <span aria-hidden="true">↗</span></a><a class="text-link" href={sitePath('/contact/')}>Discuss your requirements <span aria-hidden="true">↗</span></a></div>
    </section>
  </div>
</Layout>

<script>
  // Product-only offsets follow wrapping links and the shared header's actual height.
  // Sticky positioning and native anchor links still work without JavaScript.
  const productPage = document.querySelector<HTMLElement>('.product-page');
  const sectionNav = productPage?.querySelector<HTMLElement>('.product-section-nav');
  const siteHeader = document.querySelector<HTMLElement>('.site-header');
  if (productPage && sectionNav && siteHeader) {
    const updateNavigationOffsets = () => {
      productPage.style.setProperty('--product-header-height', `${siteHeader.getBoundingClientRect().height}px`);
      productPage.style.setProperty('--product-subnav-height', `${sectionNav.getBoundingClientRect().height}px`);
      productPage.style.setProperty('--product-scroll-padding', getComputedStyle(document.documentElement).scrollPaddingTop);
    };
    updateNavigationOffsets();
    const observer = new ResizeObserver(updateNavigationOffsets);
    observer.observe(siteHeader);
    observer.observe(sectionNav);
  }
</script>
