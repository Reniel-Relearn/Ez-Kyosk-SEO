---
import Layout from '../layouts/Layout.astro';
import HeroProduct from '../components/HeroProduct.astro';
import ProductExplorer from '../components/ProductExplorer.astro';
import PaymentShowcase from '../components/PaymentShowcase.astro';
import DemoCTA from '../components/DemoCTA.astro';
import FasterOrderingIcon from '../components/FasterOrderingIcon.astro';
import MoreOrderCapacityIcon from '../components/MoreOrderCapacityIcon.astro';
import BetterServiceFlowIcon from '../components/BetterServiceFlowIcon.astro';
import PlatformImageCard from '../components/PlatformImageCard.astro';
import IndustryCard from '../components/IndustryCard.astro';
import JourneyCard from '../components/JourneyCard.astro';
import { customerJourney, faqs } from '../data/product';
import { journeyImages } from '../data/journeyImages.mjs';
import { sitePath } from '../lib/sitePath';
import '../styles/home-hero.css';
import '../styles/section-frames.css';
import '../styles/home-content.css';
import '../styles/platform-section.css';
import '../styles/products-section.css';
import '../styles/payments-section.css';
import '../styles/industries-section.css';
import '../styles/journey-section.css';
import '../styles/faq-about.css';
import '../styles/home-surfaces.css';
import '../styles/benefits.css';
import '../styles/hero-background-accents.css';
import HomeAbout from '../components/HomeAbout.astro';

const platforms = [
  ['01', 'Self-Ordering & Payments', 'Give customers a self-service ordering channel with supported electronic payment paths.'],
  ['02', 'Order Queue & Tracking', 'Help customers see which orders are being prepared and which are ready for pickup.'],
  ['03', 'Inventory & Availability', 'Keep item availability and inventory visibility aligned with daily operations.'],
  ['04', 'Reports & Insights', 'Configure reports around sales, products and the operational questions your business needs to answer.'],
  ['05', 'Cashier', 'Offer an optional cashier-assisted payment route for customers who prefer to pay in cash.'],
];

const platformImages: Record<string, { id: string; stem: string; alt: string; portrait?: boolean }> = {
  '01': { id: 'platform-ordering', stem: 'platform-self-ordering-human-v5', portrait: true, alt: 'AI-generated illustration of a customer selecting a café menu item on an Ez Kyosk kiosk with an attached payment terminal' },
  '02': { id: 'platform-queue', stem: 'platform-order-queue-ceiling-v3', portrait: true, alt: 'AI-generated illustration of a ceiling-mounted Ez Kyosk sample order display with Preparing and Ready for Pickup columns above coffee preparation' },
  '03': { id: 'platform-inventory', stem: 'platform-inventory-human-v2', portrait: true, alt: 'AI-generated illustration of a team member checking a sample inventory spreadsheet on a tablet beside café stock containers' },
  '04': { id: 'platform-reports', stem: 'platform-reports-weekly-v3', portrait: true, alt: 'AI-generated illustration of a manager reviewing an illustrative analytics dashboard on a laptop in a café' },
  '05': { id: 'platform-cashier', stem: 'platform-cashier-human-v4', portrait: true, alt: 'AI-generated illustration of a customer offering cash to a café cashier beside a staff-facing Ez Kyosk POS terminal' },
};

const industries: Array<['hospitality' | 'retail' | 'wellness' | 'services', string, string]> = [
  ['hospitality', 'Hospitality & food', 'Cafés, bakeries, restaurants, and quick-service teams can create a clearer ordering path.'],
  ['retail', 'Retail & shops', 'Bring product discovery, selection, payment, and stock visibility into one guided touchpoint.'],
  ['wellness', 'Wellness & beauty', 'Present services and add-ons with a simple path from selection to checkout.'],
  ['services', 'Services & B2B', 'Configure a customer-facing flow around the products, services, and approvals your operation needs.'],
];
---
<Layout homeHero title="Self-Ordering Kiosk Philippines | Ez Kyosk" description="Ez Kyosk connects self-ordering, POS checkout, AltPayNet payments, real-time inventory, and order tracking for Philippine businesses. Explore the product or request a demo.">
  <section class="home-hero section-shell" id="home" data-section-target>
    <div class="hero-copy" data-reveal>
      <span class="eyebrow"><i></i> SELF-ORDERING KIOSK SOFTWARE · PHILIPPINES</span>
      <h1>Self-Ordering<br /><span>Made Easy</span><br />for Your Business.</h1>
      <p class="hero-lead">Give customers the freedom to explore your menu, select their favorites, and review their orders, all from one touchscreen.</p>
      <p class="hero-audience">For cafés, bakeries, restaurants & quick-service businesses.</p>
      <div class="hero-actions"><a class="button button-secondary" href="https://reniel-relearn.github.io/EZ-Kyosk/" target="_blank" rel="noopener">Explore Ez Kyosk</a><a class="button" href={sitePath('/contact/')}>Request a Demo <span aria-hidden="true">↗</span></a></div>
    </div>
    <HeroProduct />
  </section>

  <section class="benefits-section section-shell" aria-labelledby="benefits-title" data-reveal>
    <div class="benefits-panel">
      <h2 id="benefits-title">A better way to take orders</h2>
      <div class="benefit-grid">
        <article><FasterOrderingIcon /><h3>Faster Ordering</h3><p>Let customers browse, select and review their order in one place.</p></article>
        <article><MoreOrderCapacityIcon /><h3>More Order Capacity</h3><p>Add a self-service ordering channel alongside your existing operations.</p></article>
        <article><BetterServiceFlowIcon /><h3>Better Service Flow</h3><p>Connect ordering, payment and tracking for a clearer customer journey.</p></article>
      </div>
    </div>
  </section>

  <section class="platform-section section-shell" aria-labelledby="platform-title" data-reveal>
    <div class="section-heading"><div><span class="eyebrow">One Connected Platform</span><h2 id="platform-title">Powerful features. Stronger together.</h2></div><p>Connect ordering and payments with order tracking and inventory visibility. Configure reporting around your business needs, with an optional cashier route for cash payments.</p></div>
    <div class="platform-grid">{platforms.map(([number, title, body]) => {
      const image = platformImages[number];
      const widths = image?.portrait ? [270, 540, 1080] : [320, 640, 1280];
      return image ? (
        <PlatformImageCard id={image.id} title={title} description={body}
          image={sitePath(`/assets/images/${image.stem}-${widths[1]}.webp`)}
          imageSrcSet={widths.map(width => `${sitePath(`/assets/images/${image.stem}-${width}.webp`)} ${width}w`).join(', ')}
          imageWidth={widths[1]} imageHeight={image.portrait ? 720 : 480}
          imageAlt={image.alt} />
      ) : (
        <article><span>{number}</span><div class="platform-icon" aria-hidden="true"><i></i><i></i><i></i></div><h3>{title}</h3><p>{body}</p></article>
      );
    })}</div>
  </section>

  <section class="product-section section-shell" id="products" data-section-target aria-labelledby="product-title" data-reveal>
    <div class="section-heading inverse"><div><span class="eyebrow eyebrow-light">Explore the product</span><h2 id="product-title">Five areas. One adaptable system.</h2></div><p>Core ordering, checkout, payments, inventory, and tracking are operational. Expanded reports and customer tools can be configured around client requirements.</p></div>
    <ProductExplorer />
  </section>

  <PaymentShowcase />

  <section class="how-section section-shell" id="how-it-works" data-section-target aria-labelledby="how-title" data-reveal>
    <div class="section-heading inverse"><div><span class="eyebrow eyebrow-light brand-case">How Ez Kyosk works</span><h2 id="how-title">Six simple steps.<br />One confident order.</h2></div><p>Each step keeps the customer oriented while the connected system carries the order toward checkout and fulfillment.</p></div>
    <ol class="customer-journey-grid" role="list">{customerJourney.map(({ id, title, body }) => (
      <JourneyCard id={id} title={title} description={body}
        imageStem={journeyImages[id]?.stem}
        imageAlt={journeyImages[id]?.alt} />
    ))}</ol>
  </section>

  <section class="industries-section section-shell" id="industries" data-section-target aria-labelledby="industries-title" data-reveal>
    <div class="section-heading"><div><span class="eyebrow">Designed to adapt</span><h2 id="industries-title">Different operations.<br />One clearer experience.</h2></div><p>Hospitality is the starting point, but the same guided ordering pattern can support a wider range of customer-facing businesses.</p></div>
    <div class="industry-grid">{industries.map(([id, title, body]) => (
      <IndustryCard id={id} title={title} description={body}
        imageStem={id === 'hospitality' ? 'industry-hospitality-v3' : id === 'retail' ? 'industry-retail-v3' : id === 'wellness' ? 'industry-wellness-v2' : id === 'services' ? 'industry-services-v7' : undefined}
        imageAlt={id === 'hospitality' ? 'AI-generated illustration of a customer using an Ez Kyosk kiosk beside a café counter while a barista prepares a drink' : id === 'retail' ? 'AI-generated illustration of a shopper and shop associate discussing a boxed accessory beside an unbranded staff-facing POS' : id === 'wellness' ? 'AI-generated illustration of a salon client and adviser discussing a styling leaflet beside an unbranded staff-facing POS' : id === 'services' ? 'AI-generated illustration of a service adviser holding a portrait tablet with an unbranded four-service interface including Custom Setup for a business client' : undefined} />
    ))}</div>
  </section>

  <section class="faq-section section-shell" aria-labelledby="faq-title" data-reveal>
    <div class="faq-intro"><span class="eyebrow">Questions, answered</span><h2 id="faq-title">What businesses ask before a demo.</h2><p>Clear answers about capabilities, payments, customization, compatibility, and pricing.</p></div>
    <div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true"></span></summary><p>{answer}</p></details>)}
      <div class="faq-actions"><a class="text-link" href={sitePath('/contact/')}>Ask a different question <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  <HomeAbout />
  <DemoCTA />
</Layout>
