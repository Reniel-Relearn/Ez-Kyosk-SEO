---
import Layout from '../layouts/Layout.astro';
import DemoCTA from '../components/DemoCTA.astro';
import BrandMark from '../components/BrandMark.astro';
import { sitePath } from '../lib/sitePath';
const industries = [
  { id: 'hospitality', number: '01', name: 'Hospitality & food', title: 'Make the menu easier to explore.', body: 'Give guests a focused ordering path for food, beverages, variants, add-ons, review, payment, and order progress.', uses: ['Cafés and coffee shops', 'Bakeries and pastry shops', 'Restaurants', 'Quick-service businesses'] },
  { id: 'retail', number: '02', name: 'Retail & shops', title: 'Connect product choice to checkout.', body: 'Create a guided product-browsing and checkout touchpoint with payment, real-time inventory visibility, and configurable business logic.', uses: ['Specialty retail', 'Pop-up shops', 'Showrooms', 'Catalog-led sales'] },
  { id: 'wellness', number: '03', name: 'Wellness & beauty', title: 'Present services and add-ons clearly.', body: 'Help customers understand available services, options, and related products before moving into a configured checkout flow.', uses: ['Salons and studios', 'Wellness centers', 'Beauty services', 'Membership-led concepts'] },
  { id: 'services', number: '04', name: 'Services & B2B', title: 'Shape a flow around your requirements.', body: 'Use the kiosk pattern for customer-facing selection, request capture, payment, order status, or other workflows scoped for the operation.', uses: ['Service counters', 'B2B ordering', 'Events and venues', 'Custom customer journeys'] },
];
---
<Layout title="Self-Ordering Kiosk Solutions by Industry | Ez Kyosk" description="Explore Ez Kyosk solutions for hospitality, cafés, restaurants, retail, wellness, beauty, services, and configurable B2B ordering workflows.">
  <section class="page-hero text-hero section-shell"><div class="page-hero-copy" data-reveal><span class="eyebrow">Solutions · Designed to adapt</span><h1>Your operation has a rhythm.<br /><span>The experience should fit.</span></h1><p>Start with a clear customer journey, then configure the products, services, checkout, payments, inventory, tracking, and operational requirements around your business.</p><div class="hero-actions"><a class="button" href={sitePath('/contact/')}>Discuss your use case <span aria-hidden="true">↗</span></a><a class="button button-secondary" href="#industries">Explore industries</a></div></div><div class="solution-orbit" aria-hidden="true"><div><span>Order</span><span>Pay</span><span>Track</span><span>Adapt</span><b><BrandMark /></b></div></div></section>
  <section class="industry-solutions section-shell" id="industries" aria-labelledby="industry-solutions-title"><div class="section-heading"><div><span class="eyebrow">Industry patterns</span><h2 id="industry-solutions-title">A strong starting point.<br />Not a rigid template.</h2></div><p>Each industry section describes a possible fit, not a claim that every workflow is included by default. Final scope is defined around verified requirements.</p></div>{industries.map(industry => <article class={`solution-row solution-${industry.id}`} id={industry.id} data-reveal><div class="solution-number">{industry.number}</div><div class="solution-visual" aria-hidden="true"><span></span><i></i><i></i><i></i></div><div class="solution-copy"><span class="eyebrow">{industry.name}</span><h2>{industry.title}</h2><p>{industry.body}</p><ul>{industry.uses.map(use => <li>{use}</li>)}</ul><a class="text-link" href={sitePath('/contact/')}>Discuss this use case <span aria-hidden="true">↗</span></a></div></article>)}</section>
  <section class="configuration-matrix section-shell" data-reveal><div><span class="eyebrow eyebrow-light">What can be configured</span><h2>Build around the operation, not the other way around.</h2></div><div class="matrix"><div><b>Customer experience</b><span>Menus, catalogs, service selection, options, cart, and review</span></div><div><b>Checkout and payments</b><span>POS flow, terminal, card, QR, GCash, Maya, and e-wallet paths</span></div><div><b>Operations</b><span>Order queueing, status tracking, inventory, printing, and handoff needs</span></div><div><b>Growth tools</b><span>Reports, analytics, customers, loyalty, promotions, and bespoke features</span></div></div></section>
  <DemoCTA />
</Layout>
