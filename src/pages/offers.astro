---
import Layout from '../layouts/Layout.astro';
import {sitePath} from '../lib/sitePath';
---
<Layout title="Plans & Pricing | Ez Kyosk" description="Plans and pricing page layout for Ez Kyosk. Discuss your requirements while the detailed package presentation is prepared.">
  <section class="wireframe-page section-shell" aria-labelledby="plans-title">
    <header><span class="eyebrow">Plans & Pricing</span><h1 id="plans-title">A setup around your business.</h1><p>This page is a design-review wireframe. Package details, prices and visual assets will be presented in the dedicated Plans & Pricing phase.</p></header>
    <div class="wireframe-grid">{['Demo','Starter','Complete'].map(title=><article class="wireframe-slot" data-plan-placeholder><div class="visual-slot" aria-hidden="true">Visual placeholder</div><h2>{title}</h2><p>Package information reserved for the approved pricing presentation.</p></article>)}</div>
    <p style="margin-top:32px"><a class="button" href={sitePath('/contact/')}>Discuss your requirements</a></p>
  </section>
</Layout>
