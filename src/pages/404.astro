---
import Layout from '../layouts/Layout.astro';
import { sitePath } from '../lib/sitePath';
---
<Layout title="Page Not Found | EZ Kyosk" description="This EZ Kyosk page could not be found. Return home, explore the product, or request a demo.">
  <section class="not-found section-shell"><span class="error-code" aria-hidden="true">404</span><div><span class="eyebrow">Page not found</span><h1>This order took<br /><span>a different route.</span></h1><p>The page may have moved, or the address may be incomplete. Choose a clear next step below.</p><div class="hero-actions"><a class="button" href={sitePath('/')}>Return home</a><a class="button button-secondary" href={sitePath('/features/')}>Explore the product</a><a class="text-link" href={sitePath('/contact/')}>Request a Demo <span aria-hidden="true">↗</span></a></div></div></section>
</Layout>
