---
import BrandMark from './BrandMark.astro';
import { brandName } from '../lib/brand';
import { sitePath } from '../lib/sitePath';
const { eager = false } = Astro.props;
---
<a href={sitePath('/')} class="logo logo-lockup" aria-label={`${brandName} home`}>
  <BrandMark eager={eager} adaptive />
</a>
