---
interface Props { kind: string; }
const { kind } = Astro.props;
---
<svg class="product-tab-icon" data-product-icon={kind} viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {kind === 'self-ordering' && <><rect x="5" y="2" width="14" height="17" rx="2" /><path d="M9 22h6m-3-3v3" /><circle cx="11" cy="9" r="2" /><path d="m12.5 10.5 2.5 3" /></>}
  {kind === 'pos-checkout' && <><rect x="4" y="3" width="16" height="10" rx="2" /><path d="M12 13v4M5 17h14l2 4H3l2-4ZM8 7h8" /></>}
  {kind === 'inventory' && <><path d="m12 3 9 5-9 5-9-5 9-5ZM3 8v9l9 5 9-5V8M12 13v9M7.5 5.5l9 5" /></>}
  {kind === 'reports' && <><path d="M3 3v18h18M7 16v-4m5 4V7m5 9v-6" /></>}
  {kind === 'customers' && <><circle cx="9" cy="7" r="3" /><path d="M3 21v-2a6 6 0 0 1 12 0v2M16 4a3 3 0 0 1 0 6m2 4a5 5 0 0 1 3 5v2" /></>}
</svg>
