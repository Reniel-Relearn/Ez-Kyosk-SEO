---
import { sampleMenu, sampleOrderTotal, sampleOrderQuantity, formatSamplePrice } from '../data/nativeProducts.mjs';
const iconPaths = ['M4 8h12v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8Zm12 1h2a3 3 0 0 1 0 6h-2M3 22h15M8 3v2m4-2v2', 'M3 10 12 4l9 6v9H3v-9Zm0 0h18M3 14h18M7 7l2 1m5-2 2 1', 'M20 10a4 4 0 0 1-6-6A9 9 0 1 0 20 10ZM8 9h.01M7 15h.01M13 16h.01M12 11h.01'];
---
<aside class="product-native" data-native-product="self-ordering" aria-label="Self-ordering interface">
  <div class="product-native-header">
    <div><h4>Current Order <span class="product-native-order-id">#001</span></h4><span class="product-native-dine-in">Dine-in</span></div>
  </div>
      <ul class="product-native-items" aria-label="Current order items">
        {sampleMenu.map((item, index) => <li data-order-row data-item-name={item.name} data-unit-price={item.unitPrice} data-quantity={item.quantity}>
          <span class="product-native-item-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={iconPaths[index]} /></svg></span>
          <div class="product-native-item-info"><span class="product-native-item-name">{item.name}</span><span class="product-native-unit-price">{formatSamplePrice(item.unitPrice)} each</span></div>
            <div class="product-native-quantity" role="group" aria-label={`${item.name} quantity`}>
              <button type="button" data-quantity-change="-1" aria-label={`Decrease ${item.name} quantity`} disabled>−</button>
              <output data-quantity-value aria-label={`${item.name} quantity`}>{item.quantity}</output>
              <button type="button" data-quantity-change="1" aria-label={`Increase ${item.name} quantity`} disabled>+</button>
            </div>
          <span class="product-native-number product-native-row-amount" data-row-amount aria-label={`${item.name} amount`}>{formatSamplePrice(item.unitPrice * item.quantity)}</span>
        </li>)}
      </ul>
      <div class="product-native-summary">
        <div class="product-native-subtotal"><span>Subtotal</span><span class="product-native-number" data-order-subtotal>{formatSamplePrice(sampleOrderTotal)}</span></div>
        <div class="product-native-total"><span>Total</span><strong class="product-native-number" data-sample-order-total={sampleOrderTotal}>{formatSamplePrice(sampleOrderTotal)}</strong></div>
        <p class="product-native-order-count" data-order-count>{sampleOrderQuantity} items</p>
        <button type="button" class="product-native-checkout" aria-disabled="true">Proceed to Checkout <span aria-hidden="true">→</span></button>
      </div>
      <p class="product-native-sr-only" role="status" aria-live="polite" aria-atomic="true" data-order-status></p>
      <noscript><p class="product-native-note">Enable JavaScript to adjust quantities.</p></noscript>
</aside>
<script>
  import { clampSampleQuantity, sampleQuantityLimit, formatSamplePrice } from '../data/nativeProducts.mjs';
  document.querySelectorAll<HTMLElement>('[data-native-product="self-ordering"]').forEach(preview => {
    const rows = [...preview.querySelectorAll<HTMLElement>('[data-order-row]')];
    const render = (changed?: HTMLElement) => {
      let total = 0, count = 0;
      rows.forEach(row => {
        const quantity = clampSampleQuantity(row.dataset.quantity);
        const amount = Number(row.dataset.unitPrice) * quantity;
        row.dataset.quantity = String(quantity);
        row.querySelector<HTMLOutputElement>('[data-quantity-value]')!.textContent = String(quantity);
        row.querySelector<HTMLElement>('[data-row-amount]')!.textContent = formatSamplePrice(amount);
        row.querySelector<HTMLButtonElement>('[data-quantity-change="-1"]')!.disabled = quantity === 0;
        row.querySelector<HTMLButtonElement>('[data-quantity-change="1"]')!.disabled = quantity === sampleQuantityLimit;
        total += amount; count += quantity;
      });
      const totalCell = preview.querySelector<HTMLElement>('[data-sample-order-total]')!;
      totalCell.textContent = formatSamplePrice(total);
      totalCell.dataset.sampleOrderTotal = String(total);
      preview.querySelector<HTMLElement>('[data-order-subtotal]')!.textContent = formatSamplePrice(total);
      preview.querySelector<HTMLElement>('[data-order-count]')!.textContent = `${count} ${count === 1 ? 'item' : 'items'}`;
      if (changed) preview.querySelector<HTMLElement>('[data-order-status]')!.textContent =
        `${changed.dataset.itemName} quantity ${changed.dataset.quantity}. Order total ${formatSamplePrice(total)}.`;
    };
    render();
    preview.addEventListener('click', event => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLButtonElement>('button[data-quantity-change]');
      if (!button || button.disabled || !preview.contains(button)) return;
      const row = button.closest<HTMLElement>('[data-order-row]');
      if (!row) return;
      row.dataset.quantity = String(clampSampleQuantity(Number(row.dataset.quantity) + Number(button.dataset.quantityChange)));
      render(row);
    });
  });
</script>
