---
const { kind } = Astro.props as { kind: 'workflow' | 'operations' | 'quotation' };
---
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {kind === 'workflow' && <><rect x="3" y="3" width="7" height="5" rx="1" /><rect x="14" y="16" width="7" height="5" rx="1" /><path d="M6.5 8v10.5H14M11 15.5l3 3-3 3M10 5.5h7.5V12" /></>}
  {kind === 'operations' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18M7 15h3M15 15h2" /></>}
  {kind === 'quotation' && <><path d="M14 3H5v18h14V8l-5-5Z" /><path d="M14 3v5h5M8 12h8M8 16h5" /></>}
</svg>
