  {kind === 'wellness' && <><circle cx="12" cy="12" r="2" /><path d="M9 7c-2-6 8-6 6 0 5-4 10 4 4 6 6 2 1 10-4 6 2 6-8 6-6 0-5 4-10-4-4-6-6-2-1-10 4-6Z" transform="translate(0 -1) scale(1 .93)" /></>}
