---
import { productCategories } from '../data/product';
import { sitePath } from '../lib/sitePath';
import ProductTabIcon from './ProductTabIcon.astro';
import NativeSelfOrdering from './NativeSelfOrdering.astro';
import NativeProductPanel from './NativeProductPanel.astro';
import '../styles/product-native.css';

const inquiryLabels: Record<string, string> = {
  'self-ordering': 'Discuss Self-Ordering',
  'pos-checkout': 'Discuss POS & Checkout',
  inventory: 'Discuss Inventory',
  reports: 'Discuss Reports & Analytics',
  customers: 'Discuss Customer Tools',
};

---
<div class="product-explorer" data-product-explorer>
  <div class="product-tabs" role="tablist" aria-label="Ez Kyosk product areas">
    {productCategories.map((category, index) => <button type="button" role="tab" id={`tab-${category.id}`} aria-controls={`panel-${category.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}><ProductTabIcon kind={category.id} />{category.label}</button>)}
  </div>
  <div class="product-panels">
    {productCategories.map((category, index) => <section class="product-panel" id={`panel-${category.id}`} role="tabpanel" aria-labelledby={`tab-${category.id}`} hidden={index !== 0}>
      <div class="product-panel-copy"><span class="eyebrow">{category.eyebrow}</span><h3>{category.title}</h3><p>{category.body}</p><ul class="check-list">{category.items.map(item => <li>{item}</li>)}</ul><a class="text-link" href={sitePath('/contact/')}>{inquiryLabels[category.id]} <span aria-hidden="true">↗</span></a></div>
      {category.id === 'self-ordering' ? (
        <NativeSelfOrdering />
      ) : (
        <NativeProductPanel kind={category.id} />
      )}
    </section>)}
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-product-explorer]').forEach(explorer => {
    const tabs = [...explorer.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...explorer.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const activate = (next: number, focus = false) => {
      tabs.forEach((tab, index) => { const active = index === next; tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; panels[index].hidden = !active; });
      if (focus) tabs[next].focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', event => {
        if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        activate(next, true);
      });
    });
  });
</script>
