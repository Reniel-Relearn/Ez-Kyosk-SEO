---
import { productCategories } from '../data/product';
import { sitePath } from '../lib/sitePath';

const productImages: Record<string, { stem: string; alt: string }> = {
  'self-ordering': { stem: 'product-self-ordering-v1', alt: 'Illustrative Ez Kyosk portrait kiosk menu with generic café items and an enlarged matching order review' },
  'pos-checkout': { stem: 'product-pos-checkout-v1', alt: 'Illustrative Ez Kyosk staff checkout workstation with an order queue, receipt printer, and matching generic checkout detail' },
  'inventory': { stem: 'product-inventory-v1', alt: 'Illustrative Ez Kyosk inventory tablet beside stock containers and an enlarged sample item availability table' },
  'reports': { stem: 'product-reports-v1', alt: 'Illustrative Ez Kyosk reporting laptop with a sample item-sales chart and matching sales-summary table' },
};
---
<div class="product-explorer" data-product-explorer>
  <div class="product-tabs" role="tablist" aria-label="Ez Kyosk product areas">
    {productCategories.map((category, index) => <button type="button" role="tab" id={`tab-${category.id}`} aria-controls={`panel-${category.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}><span>0{index + 1}</span>{category.label}</button>)}
  </div>
  <div class="product-panels">
    {productCategories.map((category, index) => <section class="product-panel" id={`panel-${category.id}`} role="tabpanel" aria-labelledby={`tab-${category.id}`} hidden={index !== 0}>
      <div class="product-panel-copy"><span class="eyebrow">{category.eyebrow}</span><h3>{category.title}</h3><p>{category.body}</p><ul class="check-list">{category.items.map(item => <li>{item}</li>)}</ul><a class="text-link" href={sitePath(`/features/#${category.id}`)}>Explore this product area <span aria-hidden="true">↗</span></a></div>
      {productImages[category.id] ? (
        <div class="product-panel-visual product-panel-visual--image">
          <img class="product-panel-image" src={sitePath(`/assets/images/${productImages[category.id].stem}-960.webp`)}
            srcset={[480, 960, 1440].map(width => `${sitePath(`/assets/images/${productImages[category.id].stem}-${width}.webp`)} ${width}w`).join(', ')}
            sizes="(max-width: 720px) calc(100vw - 98px), (max-width: 980px) 80vw, 44vw"
            width="1440" height="1080" loading="lazy" decoding="async"
            alt={productImages[category.id].alt} />
        </div>
      ) : (
      <div class:list={['product-panel-visual', `visual-${category.id}`]} aria-hidden="true">
        <div class="ui-window"><div class="ui-top"><span></span><span></span><span></span><b>{category.label}</b></div><div class="ui-body"><div class="ui-sidebar"><i></i><i></i><i></i><i></i></div><div class="ui-content"><div class="ui-metric"></div><div class="ui-lines"><i></i><i></i><i></i></div><div class="ui-cards"><span></span><span></span><span></span></div></div></div></div>
      </div>
      )}
    </section>)}
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-product-explorer]').forEach(explorer => {
    const tabs = [...explorer.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...explorer.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const activate = (next: number, focus = false) => {
      tabs.forEach((tab, index) => { const active = index === next; tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; panels[index].hidden = !active; });
      if (focus) tabs[next].focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', event => {
        if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        activate(next, true);
      });
    });
  });
</script>
