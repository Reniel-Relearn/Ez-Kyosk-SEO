---
import { Image } from 'astro:assets';
import kiosk from '../../assets/hero-kiosk-original.png';
---
<figure class="hero-product" data-reveal>
  <div class="hero-orbit" aria-hidden="true"></div>
  <Image src={kiosk} alt="EZ Kyosk product artwork showing a self-ordering kiosk with a companion payment terminal" widths={[420, 640, 900]} sizes="(max-width: 720px) 82vw, 46vw" width={900} format="webp" loading="eager" fetchpriority="high" quality={84} />
  <figcaption>EZ Kyosk self-ordering and checkout system. Core capabilities include POS checkout, AltPayNet payments, real-time inventory, and order tracking.</figcaption>
</figure>
