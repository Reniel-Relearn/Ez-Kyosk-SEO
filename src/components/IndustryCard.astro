---
import IndustryIcon from './IndustryIcon.astro';
import { sitePath } from '../lib/sitePath';
interface Props {
  id: 'hospitality' | 'retail' | 'wellness' | 'services';
  title: string;
  description: string;
  imageStem?: string;
  imageAlt?: string;
}
const { id, title, description, imageStem, imageAlt = '' } = Astro.props;
---
<a class="industry-card" id={`industry-${id}`} data-section-target href={sitePath('/contact/')}>
  <div class="industry-card-media" data-image-status={imageStem ? 'approved' : 'pending'}>
    {imageStem ? (
      <img class="industry-image" src={sitePath(`/assets/images/${imageStem}-640.webp`)}
        srcset={[320, 640, 1280].map(width => `${sitePath(`/assets/images/${imageStem}-${width}.webp`)} ${width}w`).join(', ')}
        sizes="(max-width: 720px) calc(100vw - 42px), (max-width: 1180px) 46vw, 23vw"
        width="640" height="480" alt={imageAlt} loading="lazy" decoding="async" />
    ) : (
      <div class="industry-image-placeholder" aria-hidden="true">Image to follow</div>
    )}
  </div>
  <div class="industry-card-content">
    <span class="industry-card-badge" aria-hidden="true"><IndustryIcon kind={id} /></span>
    <h3 id={`industry-${id}-title`}>{title}</h3>
    <p>{description}</p>
    <span class="industry-card-cta" id={`industry-${id}-cta`}>Discuss this use case <span aria-hidden="true">→</span></span>
  </div>
</a>
